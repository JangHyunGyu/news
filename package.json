{
  "name": "hn-news",
  "version": "1.0.0",
  "description": "Hacker News 탑10 한국어 번역 뉴스 - news.archerlab.dev",
  "main": "src/index.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs && node validate.js",
